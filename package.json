{
  "name": "rbmsounds",
  "private": true,
  "version": "2026.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,cyan \"vite\" \"node api/server.js\"",
    "build": "vite build && rm -rf \"dist/RBM ARTWORK\" \"dist/Logo and Marketing\" && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "deploy": "npm run build && touch dist/.nojekyll && gh-pages -d dist -b gh-pages --dotfiles --no-history",
    "setup:stripe": "node scripts/create-stripe-links.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "gh-pages": "^6.3.0",
    "puppeteer-core": "^25.9.0",
    "vite": "^5.4.21"
  }
}
